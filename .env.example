# Synthetic local-development database configuration.
# These values document the required Compose contract and are not production
# credentials.

ORDERHUB_DB_NAME=orderhub
ORDERHUB_DB_USER=orderhub
ORDERHUB_DB_PASSWORD=synthetic-local-development-password

# Optional local HTTP binding.
ORDERHUB_HTTP_PORT=8080

# Required JWT trust for the packaged Compose runtime. These example.invalid
# addresses are intentionally fake: replace all three with your actual IdP
# configuration for authenticated use. No signing key or bearer belongs here.
# For a working synthetic local issuer use the test-run development launcher.
ORDERHUB_SECURITY_JWT_ISSUER=https://identity.example.invalid/realms/orderhub
ORDERHUB_SECURITY_JWT_AUDIENCE=orderhub-api
ORDERHUB_SECURITY_JWT_JWK_SET_URI=https://identity.example.invalid/realms/orderhub/protocol/openid-connect/certs
# Required; deliberately GENERIC for this provider-neutral example. Production
# Cognito uses COGNITO plus comma-separated admitted App Client IDs below.
ORDERHUB_SECURITY_JWT_TOKEN_PROFILE=GENERIC
ORDERHUB_SECURITY_JWT_ALLOWEDCLIENTIDS=
# Comma-separated exact frontend origins. Empty denies cross-origin browsers.
ORDERHUB_SECURITY_CORS_ALLOWED_ORIGINS=

# Optional image metadata (not authentication or release promotion).
ORDERHUB_APP_VERSION=1.0.0
ORDERHUB_VCS_REF=development
